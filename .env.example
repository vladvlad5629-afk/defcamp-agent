# Copy this file to .env and edit it. Everything here is optional.

# The model behind the gateway. Leave LLM_BASE_URL empty to use the scripted
# mock: no key, no cost. It only shows that your harness reaches the gateway.
#
# The event uses Qwen 3.8 27B at reasoning effort medium. To test against the
# same model, use OpenRouter with your own key (you pay OpenRouter for it):
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=sk-or-...
#   LLM_MODEL=qwen/qwen3.8-27b
#   LLM_REASONING_EFFORT=medium
#
# Any other OpenAI-compatible endpoint works too, for example Ollama on your
# machine: http://host.docker.internal:11434/v1, any key, and a model you have
# pulled. Leave LLM_REASONING_EFFORT empty for providers that do not take it.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_REASONING_EFFORT=

# Your team's notes for the run, as you would type them when queueing one
# (up to 4096 characters, one line here). Wrap them in single quotes:
# without quotes a # starts a comment and $NAME is replaced by a variable.
#   INSTRUCTIONS='Check the #admin page first; the token is in $HOME/.cfg'
INSTRUCTIONS=''

# Budgets. Locally every model call counts as one cent.
TIME_LIMIT_SECONDS=600
COST_LIMIT_CENTS=100

# The request format and step count are image settings: they are in
# harness/Dockerfile (ENV HARNESS_FORMAT, ENV AGENT_MAX_STEPS).
